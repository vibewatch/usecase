---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { flattenValues, topValues } from "../../lib/analytics";
import { caseStudies } from "../../lib/caseStudies";
import { FACETS, facetGroups, facetHref, type FacetKind } from "../../lib/facets";
import { industryMeta, useCaseMeta } from "../../lib/icons";
import { vendorLogoSvg, vendorStyle } from "../../lib/vendors";

export const getStaticPaths = (() =>
  (Object.keys(FACETS) as FacetKind[]).map((facet) => ({ params: { facet } }))) satisfies GetStaticPaths;

const facet = Astro.params.facet as FacetKind;
const { plural } = FACETS[facet];
const groups = facetGroups(facet, caseStudies);
const max = groups.reduce((highest, group) => Math.max(highest, group.records.length), 1);

const totalWithMetrics = caseStudies.filter((r) => r.metrics.length > 0).length;
const metricRate = Math.round((totalWithMetrics / Math.max(caseStudies.length, 1)) * 100);

const heroSubtitle: Record<FacetKind, string> = {
  vendors:
    "Explore AI customer implementations across cloud hyperscalers, frontier AI labs, data platforms, China cloud providers, and global consulting firms.",
  "use-cases":
    "Production AI patterns normalized from first-party customer stories—complete with leading vendors, quantified outcomes, and architecture depth.",
  industries:
    "Compare how enterprise sectors deploy generative AI, machine learning, and data platforms in production.",
};

const enrichedGroups = groups.map((group) => {
  const count = group.records.length;
  const withMetrics = group.records.filter((r) => r.metrics.length > 0).length;
  const impactPct = Math.round((withMetrics / Math.max(count, 1)) * 100);
  const topVendors = topValues(group.records.map((r) => r.vendor), 3);
  const topUseCases = topValues(flattenValues(group.records, (r) => r.use_case_category), 2);
  const distinctIndustries = new Set(group.records.map((r) => r.industry)).size;
  const distinctVendors = new Set(group.records.map((r) => r.vendor)).size;
  const vendorInfo = facet === "vendors" ? vendorStyle(group.value) : null;
  const catMeta =
    facet === "use-cases"
      ? useCaseMeta(group.value)
      : facet === "industries"
        ? industryMeta(group.value)
        : null;
  return {
    ...group,
    count,
    impactPct,
    topVendors,
    topUseCases,
    distinctIndustries,
    distinctVendors,
    vendorInfo,
    catMeta,
  };
});

const vendorCategories =
  facet === "vendors"
    ? Array.from(new Set(enrichedGroups.map((g) => g.vendorInfo?.category || "Other")))
    : [];
---

<BaseLayout title={`${plural} | Use Case Intelligence`} description={`Customer use cases grouped by ${plural.toLowerCase()}.`}>
  <main>
    <section class="page-hero">
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="hero__grid" aria-hidden="true"></div>
      <div class="container page-hero__inner">
        <p class="eyebrow eyebrow--light">Browse by {FACETS[facet].label.toLowerCase()}</p>
        <h1 class="page-hero__title">{plural}</h1>
        <p class="hero__lead">{heroSubtitle[facet]}</p>
        <dl class="kpi-row">
          <div class="kpi">
            <dt>{plural}</dt>
            <dd>{groups.length}</dd>
          </div>
          <div class="kpi">
            <dt>Customer stories</dt>
            <dd>{caseStudies.length.toLocaleString("en")}</dd>
          </div>
          <div class="kpi">
            <dt>With quantified impact</dt>
            <dd>{metricRate}%</dd>
          </div>
          <div class="kpi">
            <dt>Largest {FACETS[facet].label.toLowerCase()}</dt>
            <dd>{groups[0]?.records.length.toLocaleString("en") ?? 0}</dd>
          </div>
          <div class="kpi">
            <dt>Updated</dt>
            <dd>Daily</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="section section--compact">
      <div class="container">
        {facet === "vendors" && (
          <div class="hub-filter-bar" data-vendor-filter-bar>
            <button type="button" class="chip chip--filter is-active" data-vendor-cat="all">
              All vendors <span class="chip__count">{enrichedGroups.length}</span>
            </button>
            {vendorCategories.map((cat) => {
              const catCount = enrichedGroups.filter((g) => g.vendorInfo?.category === cat).length;
              return (
                <button type="button" class="chip chip--filter" data-vendor-cat={cat}>
                  {cat} <span class="chip__count">{catCount}</span>
                </button>
              );
            })}
          </div>
        )}

        <ul class:list={["hub-grid", `hub-grid--${facet}`]}>
          {enrichedGroups.map((group) => (
            <li data-vendor-card-cat={group.vendorInfo?.category}>
              {facet === "vendors" && group.vendorInfo ? (
                <a
                  class="hub-card hub-card--vendor"
                  href={facetHref(facet, group.value)}
                  style={`--card-accent: ${group.vendorInfo.color}`}
                >
                  <div class="hub-card__header">
                    <span class="hub-card__logo" set:html={vendorLogoSvg(group.value, group.vendorInfo.mark)} />
                    <div class="hub-card__title-wrap">
                      <span class="hub-card__name">{group.value}</span>
                      <span class="hub-card__category">{group.vendorInfo.category}</span>
                    </div>
                    <span class="hub-card__badge">{group.count.toLocaleString("en")}</span>
                  </div>

                  <div class="hub-card__stats">
                    <span>
                      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M2.5 13.5V6.8l3.6 2V6.8l3.6 2V4.5h3.8v9H2.5Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                      {group.distinctIndustries} {group.distinctIndustries === 1 ? "industry" : "industries"}
                    </span>
                    <span>
                      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M2.5 12.5 6.5 8l2.8 2.8L13.8 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {group.impactPct}% with metrics
                    </span>
                  </div>

                  {group.topUseCases.length > 0 && (
                    <div class="hub-card__tags">
                      {group.topUseCases.map((uc) => (
                        <span class="tag">{uc.label}</span>
                      ))}
                    </div>
                  )}

                  <span class="hub-card__bar" aria-hidden="true">
                    <span style={`width: ${Math.max(4, (group.count / max) * 100)}%; background: ${group.vendorInfo.color}`}></span>
                  </span>
                </a>
              ) : (
                <a
                  class="hub-card hub-card--category"
                  href={facetHref(facet, group.value)}
                  style={`--card-accent: ${group.catMeta?.accent ?? "#0c7c6c"}`}
                >
                  <div class="hub-card__header">
                    <span class="hub-card__icon" style={`--icon-accent: ${group.catMeta?.accent ?? "#0c7c6c"}`}>
                      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" set:html={group.catMeta?.svg ?? ""} />
                    </span>
                    <div class="hub-card__title-wrap">
                      <span class="hub-card__name">{group.value}</span>
                      <span class="hub-card__count">
                        {group.count.toLocaleString("en")} use {group.count === 1 ? "case" : "cases"} · {group.impactPct}% quantified
                      </span>
                    </div>
                    <span class="hub-card__arrow" aria-hidden="true">→</span>
                  </div>

                  {group.catMeta?.summary && <p class="hub-card__desc">{group.catMeta.summary}</p>}

                  {group.topVendors.length > 0 && (
                    <div class="hub-card__vendors">
                      <span class="hub-card__vendors-label">Top vendors</span>
                      <div class="hub-card__vendor-pills">
                        {group.topVendors.map((v) => {
                          const vStyle = vendorStyle(v.label);
                          return (
                            <span class="vendor-mini-pill">
                              <span class="vendor-mini-pill__logo" set:html={vendorLogoSvg(v.label, vStyle.mark)} />
                              <span class="vendor-mini-pill__name">{v.label}</span>
                              <span class="vendor-mini-pill__count">{v.count}</span>
                            </span>
                          );
                        })}
                      </div>
                    </div>
                  )}

                  <span class="hub-card__bar" aria-hidden="true">
                    <span style={`width: ${Math.max(4, (group.count / max) * 100)}%; background: ${group.catMeta?.accent ?? "var(--series-1)"}`}></span>
                  </span>
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  {facet === "vendors" && (
    <script>
      const bar = document.querySelector("[data-vendor-filter-bar]");
      if (bar) {
        const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>("[data-vendor-cat]"));
        const cards = Array.from(document.querySelectorAll<HTMLLIElement>("[data-vendor-card-cat]"));
        for (const btn of buttons) {
          btn.addEventListener("click", () => {
            const cat = btn.dataset.vendorCat || "all";
            for (const b of buttons) b.classList.toggle("is-active", b === btn);
            for (const card of cards) {
              card.hidden = cat !== "all" && card.dataset.vendorCardCat !== cat;
            }
          });
        }
      }
    </script>
  )}
</BaseLayout>

