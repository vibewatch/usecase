---
import CaseCard from "../../components/CaseCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { caseStudies } from "../../lib/caseStudies";
import {
  formatDate,
  formatPercent,
  groupComponentsByLayer,
  hasSolutionComponents,
  isParseableDate,
  relatedRecords,
  solutionComponents,
  sourceReferences,
  valueLabel,
} from "../../lib/analytics";
import { href } from "../../lib/paths";
import type { CaseStudyRecord } from "../../lib/types";
import { vendorStyle } from "../../lib/vendors";
import { toCardRecord } from "../../lib/weeks";
import { facetHref, newestKey, publishedYear } from "../../lib/facets";
import taxonomy from "../../../taxonomy.json";

type Props = {
  record: CaseStudyRecord;
};

export function getStaticPaths() {
  return caseStudies.map((record) => ({ params: { slug: record.slug }, props: { record } }));
}

const { record } = Astro.props as Props;

const vendor = vendorStyle(record.vendor);
const layerOrder: string[] = (taxonomy as { component_layers?: string[] }).component_layers ?? [];
const components = solutionComponents(record);
const componentsByLayer = hasSolutionComponents(record) ? groupComponentsByLayer(components, layerOrder) : [];
const integrationPoints = record.integration_points ?? [];
const dataFlow = record.data_flow?.trim() ?? "";
const metrics = record.metrics.slice(0, 4);
const related = relatedRecords(record, caseStudies, 3);
const published = isParseableDate(record.published_date) ? formatDate(record.published_date) : "Not stated";
const sourceLanguage = record.source_language?.trim().toLowerCase();
const translatedFrom =
  sourceLanguage && sourceLanguage !== "en"
    ? (new Intl.DisplayNames(["en"], { type: "language" }).of(sourceLanguage) ?? sourceLanguage)
    : "";
const references = sourceReferences(record);
const dateEvidence = record.date_evidence ?? [];
const valueScore = record.value_score ?? 0;
const valueBreakdown = record.value_breakdown ?? [];
const confidenceBreakdown = record.confidence_breakdown ?? [];
const fieldLabels: Record<string, string> = {
  customer_name: "Customer",
  industry: "Industry",
  region: "Region",
  company_size: "Company size",
  business_problem: "Business problem",
  solution_summary: "Solution",
  products_used: "Products",
  solution_components: "Solution components",
  data_flow: "Data flow",
  integration_points: "Integrations",
  business_outcome: "Business outcome",
  metrics: "Metrics",
  architecture_clues: "Architecture",
  published_date: "Publication date",
};
const profileFields = ["customer_name", "industry", "region", "company_size", "business_problem", "solution_summary", "business_outcome", "metrics"];
const unsourcedFields = profileFields.filter((field) => !(record.field_sources?.[field]?.length));

// Search index (Pagefind): filters, sort keys and the fields result cards need.
const card = toCardRecord(record);
const searchFilters: Array<[string, string[]]> = [
  ["vendor", [record.vendor]],
  ["industry", [record.industry]],
  ["usecase", record.use_case_category],
  ["area", record.technical_area],
  ["outcome", record.outcome_category],
  ["year", [publishedYear(record)]],
];
const searchMeta: Record<string, string> = {
  vendor: card.vendor,
  mark: card.vendorMark,
  color: card.vendorColor,
  industry: card.industry,
  region: card.region,
  problem: card.problem,
  metric: card.metric,
  published: card.published,
  maturity: String(card.maturity),
  usecases: card.useCases.join("|"),
  products: card.products.join(" · "),
  sample: card.sample ? "1" : "0",
};
---

<BaseLayout
  title={`${record.customer_name} × ${record.vendor} — ${record.use_case_category[0] ?? "Use case"} | Use Case Intelligence`}
  description={record.business_problem.slice(0, 160)}
>
  <main data-pagefind-body>
    <div hidden data-pagefind-ignore="index">
      {searchFilters.map(([name, values]) => values.map((value) => <span data-pagefind-filter={name}>{value}</span>))}
      {Object.entries(searchMeta).map(([name, value]) => <span data-pagefind-meta={name}>{value}</span>)}
      <span data-pagefind-sort="published">{newestKey(record) || "0000-00-00"}</span>
      <span data-pagefind-sort="maturity">{String(record.maturity_score)}</span>
    </div>
    <section class="detail-hero">
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="hero__grid" aria-hidden="true"></div>
      <div class="container detail-hero__inner">
        <div class="detail-hero__copy">
          <nav class="breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore>
            <a href={href("/")}>Dashboard</a>
            <span aria-hidden="true">/</span>
            <a href={facetHref("vendors", record.vendor)}>{record.vendor}</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{record.customer_name}</span>
          </nav>
          <div class="detail-hero__chips">
            <span class="vendor-tag vendor-tag--glass">
              <span class="vendor-tag__mark" style={`--vendor: ${vendor.color}`}>{vendor.mark}</span>
              {record.vendor}
            </span>
            <span class="chip chip--glass">{record.industry}</span>
            <span class="chip chip--glass">{record.region}</span>
            {translatedFrom && <span class="chip chip--glass" title="This summary was translated to English from the original story">Translated from {translatedFrom}</span>}
            {record.source_type === "company" && <span class="chip chip--glass" title={`Published by ${record.customer_name} on its own website`}>Company newsroom</span>}
            {record.is_sample && <span class="chip chip--warn">Sample</span>}
          </div>
          <h1 class="detail-hero__title" data-pagefind-meta="title" data-pagefind-weight="10">{record.customer_name}</h1>
          {record.use_case_category.length > 0 && (
            <p class="detail-hero__usecase text-gradient">{record.use_case_category.join(" · ")}</p>
          )}
          <p class="detail-hero__lead">{record.business_problem}</p>
          <div class="detail-hero__actions">
            <a class="btn btn--primary" href={record.source_url} target="_blank" rel="noreferrer">
              Read the original story
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M5 3h8v8h-1.5V5.56l-7.47 7.47-1.06-1.06L10.44 4.5H5z"/></svg>
            </a>
            <a class="btn btn--glass" href={href("/explore/")}>Explore all use cases</a>
          </div>
        </div>

        <aside class="score-card" aria-label="Quality scores">
          <span class="score-card__label">Customer reference value</span>
          <strong class="score-card__value">{valueScore}<span>/100</span></strong>
          <span class="score-card__pill">{valueLabel(valueScore)}</span>
          <dl class="score-card__facts">
            <div><dt>Evidence confidence</dt><dd>{formatPercent(record.confidence_score)}</dd></div>
            <div><dt>Published</dt><dd>{published}</dd></div>
          </dl>
          <a class="evidence-jump evidence-jump--dark" href="#score-methodology">
            <span>How scores are calculated</span>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M3 7.25h7.44L7.47 4.28l1.06-1.06L13.31 8l-4.78 4.78-1.06-1.06 2.97-2.97H3z"/></svg>
          </a>
        </aside>
      </div>
    </section>

    {metrics.length > 0 && (
      <section class="container metric-strip" aria-label="Key metrics">
        {metrics.map((metric) => (
          <div class="metric-tile">
            <span class="metric-tile__icon" aria-hidden="true">↗</span>
            <span>{metric}</span>
          </div>
        ))}
      </section>
    )}

    <div class="container detail-layout">
      <div class="detail-main">
        <article class="panel prose-panel">
          <h2>Solution</h2>
          <p>{record.solution_summary}</p>
          {dataFlow && (
            <>
              <h3>Data flow</h3>
              <p>{dataFlow}</p>
            </>
          )}
        </article>

        <article class="panel">
          <header class="panel__head">
            <h2>Solution architecture</h2>
            <span class="panel__meta">
              {hasSolutionComponents(record)
                ? `${components.length} components · ${componentsByLayer.length} ${componentsByLayer.length === 1 ? "layer" : "layers"}`
                : `${record.products_used.length} products mentioned`}
            </span>
          </header>
          {hasSolutionComponents(record) ? (
            <ol class="arch-stack">
              {componentsByLayer.map(({ layer, items }) => (
                <li class="arch-layer">
                  <span class="arch-layer__label">{layer}</span>
                  <ul class="arch-layer__items">
                    {items.map((item) => (
                      <li class="arch-component">
                        <strong>{item.name}</strong>
                        <span>{item.role}</span>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ol>
          ) : (
            <ul class="tag-cloud">
              {record.products_used.map((product) => <li class="tag tag--lg">{product}</li>)}
            </ul>
          )}
        </article>

        {record.architecture_clues.length > 0 && (
          <article class="panel">
            <header class="panel__head"><h2>Architecture clues</h2></header>
            <ul class="check-list">
              {record.architecture_clues.map((clue) => <li>{clue}</li>)}
            </ul>
          </article>
        )}

        {record.evidence_quotes.length > 0 && (
          <article class="panel">
            <header class="panel__head"><h2>Evidence from the source</h2></header>
            <div class="quotes">
              {record.evidence_quotes.map((quote) => <blockquote class="quote">{quote}</blockquote>)}
            </div>
          </article>
        )}

      </div>

      <aside class="detail-side">
        <article class="panel panel--accent">
          <h2>Business outcome</h2>
          <p>{record.business_outcome}</p>
          {record.outcome_category.length > 0 && (
            <ul class="tag-cloud">
              {record.outcome_category.map((outcome) => <li class="tag tag--accent">{outcome}</li>)}
            </ul>
          )}
        </article>

        <article class="panel">
          <h2>At a glance</h2>
          <dl class="facts">
            <div><dt>Customer</dt><dd>{record.customer_name}</dd></div>
            <div><dt>Industry</dt><dd>{record.industry}</dd></div>
            <div><dt>Region</dt><dd>{record.region}</dd></div>
            <div><dt>Company size</dt><dd>{record.company_size}</dd></div>
          </dl>
          <h3>Technical areas</h3>
          <ul class="tag-cloud">
            {record.technical_area.map((area) => (
              <li><a class="tag tag--link" href={href(`/explore/?area=${encodeURIComponent(area)}`)}>{area}</a></li>
            ))}
          </ul>
          <h3>Products</h3>
          <ul class="tag-cloud">
            {record.products_used.map((product) => <li class="tag">{product}</li>)}
          </ul>
          {integrationPoints.length > 0 && (
            <>
              <h3>Integration points</h3>
              <ul class="tag-cloud">
                {integrationPoints.map((point) => <li class="tag">{point}</li>)}
              </ul>
            </>
          )}
          <a class="evidence-jump evidence-jump--light" href="#sources">
            <span class="evidence-jump__label">
              <span>Sources &amp; provenance</span>
              <span class="evidence-jump__count">{references.length}</span>
            </span>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M3 7.25h7.44L7.47 4.28l1.06-1.06L13.31 8l-4.78 4.78-1.06-1.06 2.97-2.97H3z"/></svg>
          </a>
          <a class="btn btn--secondary btn--block" href={record.source_url} target="_blank" rel="noreferrer">Open source page</a>
        </article>
      </aside>
    </div>

    <section class="evidence-section" aria-labelledby="evidence-title">
      <div class="container">
        <header class="evidence-section__head">
          <div>
            <p class="eyebrow">Transparency</p>
            <h2 id="evidence-title">Evidence &amp; methodology</h2>
          </div>
          <p>Review how this reference was scored and trace each normalized claim back to its documented source.</p>
        </header>

        <div class="evidence-section__grid">
          <article class="evidence-sheet evidence-sheet--score" id="score-methodology">
            <header class="evidence-sheet__head">
              <span>01</span>
              <div>
                <p>Scoring methodology</p>
                <h3>How scores are calculated</h3>
              </div>
            </header>
            <p class="evidence-sheet__intro">Customer Reference Value measures usefulness as a customer reference. Evidence Confidence measures the quality and traceability of available evidence, not independent verification.</p>
            <div class="evidence-score-grid">
              <section class="rubric">
                <div class="rubric__head">
                  <div><span>Customer reference value</span><strong>{valueScore}/100</strong></div>
                </div>
                <ul class="rubric__criteria">
                  {valueBreakdown.map((item) => (
                    <li>
                      <div class="rubric__row"><span>{item.criterion}</span><strong>{item.score}/{item.max_score}</strong></div>
                      <span class="rubric__track"><span style={`width: ${(item.score / item.max_score) * 100}%`}></span></span>
                      <small>{item.explanation}</small>
                    </li>
                  ))}
                </ul>
              </section>
              <section class="rubric">
                <div class="rubric__head">
                  <div><span>Evidence confidence</span><strong>{formatPercent(record.confidence_score)}</strong></div>
                </div>
                <ul class="rubric__criteria">
                  {confidenceBreakdown.map((item) => (
                    <li>
                      <div class="rubric__row"><span>{item.criterion}</span><strong>{item.score}/{item.max_score}</strong></div>
                      <span class="rubric__track rubric__track--confidence"><span style={`width: ${(item.score / item.max_score) * 100}%`}></span></span>
                      <small>{item.explanation}</small>
                    </li>
                  ))}
                </ul>
              </section>
            </div>
          </article>

          <article class="evidence-sheet evidence-sheet--sources" id="sources">
            <header class="evidence-sheet__head">
              <span>02</span>
              <div>
                <p>Traceability</p>
                <h3>Sources &amp; provenance</h3>
              </div>
            </header>
            <p class="evidence-sheet__intro">Field coverage shows which facts each source supports. Dates are shown only when documented by the source.</p>
            <ol class="source-list">
              {references.map((reference) => (
                <li class="source-card">
                  <div class="source-card__head">
                    <div>
                      <span class="source-card__publisher">{reference.publisher}</span>
                      <h3>{reference.title}</h3>
                    </div>
                    <span class="tag">{reference.authority}</span>
                  </div>
                  <a class="source-card__url" href={reference.url} target="_blank" rel="noreferrer">{reference.url}</a>
                  <dl class="source-card__meta">
                    <div><dt>Source type</dt><dd>{reference.source_type}</dd></div>
                    <div><dt>Published</dt><dd>{isParseableDate(reference.published_date) ? formatDate(reference.published_date) : "Not documented"}</dd></div>
                  </dl>
                  <div class="source-card__supports">
                    <span>Supports</span>
                    <ul class="tag-cloud">
                      {reference.supports.map((field) => <li class="tag">{fieldLabels[field] ?? field.replaceAll("_", " ")}</li>)}
                    </ul>
                  </div>
                </li>
              ))}
            </ol>
            {dateEvidence.length > 0 && (
              <div class="date-evidence">
                <h3>Date evidence</h3>
                <ul>
                  {dateEvidence.map((item) => (
                    <li>
                      <div>
                        <strong>{item.type}</strong>
                        <span>{formatDate(item.date)} · {item.publisher} · {item.authority}</span>
                      </div>
                      <a href={item.url} target="_blank" rel="noreferrer">Open date source</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {unsourcedFields.length > 0 && (
              <div class="provenance-warning">
                <strong>Not separately sourced</strong>
                <span>{unsourcedFields.map((field) => fieldLabels[field] ?? field).join(", ")}. Treat these normalized attributes as lower-confidence until a dedicated source is added.</span>
              </div>
            )}
          </article>
        </div>
      </div>
    </section>

    {related.length > 0 && (
      <section class="section section--tinted" data-pagefind-ignore="all">
        <div class="container">
          <div class="section__head">
            <div>
              <p class="eyebrow">Related</p>
              <h2 class="section__title">Similar use cases</h2>
            </div>
            <a class="btn btn--ghost btn--small" href={record.use_case_category[0] ? facetHref("use-cases", record.use_case_category[0]) : href("/explore/")}>See all like this</a>
          </div>
          <div class="card-grid">
            {related.map((item) => <CaseCard card={toCardRecord(item)} />)}
          </div>
        </div>
      </section>
    )}
  </main>

</BaseLayout>
