---
import BarList from "../components/BarList.astro";
import CaseCard from "../components/CaseCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  countValues,
  flattenValues,
  formatDate,
  headlineMetric,
  sortByRecency,
  topValues,
  uniqueSorted,
} from "../lib/analytics";
import { caseStudies } from "../lib/caseStudies";
import { facetHref, sortNewest } from "../lib/facets";
import { caseHref, href } from "../lib/paths";
import { groupByWeek, toCardRecord, UNDATED_WEEK } from "../lib/weeks";
import { vendorLogoSvg, vendorStyle } from "../lib/vendors";

// Insights describe the real market signal; synthetic seed rows only count
// when nothing has been extracted yet.
const realRecords = caseStudies.filter((record) => !record.is_sample);
const signal = realRecords.length > 0 ? realRecords : caseStudies;
const sampleCount = caseStudies.length - realRecords.length;

const vendors = uniqueSorted(caseStudies.map((record) => record.vendor));
const industries = uniqueSorted(caseStudies.map((record) => record.industry));

const vendorCounts = countValues(signal.map((record) => record.vendor));
const industryCounts = countValues(signal.map((record) => record.industry));
const topUseCases = topValues(flattenValues(signal, (record) => record.use_case_category), 8);
// Company-newsroom stories add many one-story vendors: the strip shows the established
// ones (and In-house) and links the long tail to the vendor hub.
const STRIP_MIN = 5;
const stripVendors = vendorCounts.filter((entry) => entry.count >= STRIP_MIN);
const tailVendors = vendorCounts.length - stripVendors.length;
const leadVendors = vendorCounts.filter((entry) => entry.label !== "In-house").slice(0, 5).map((entry) => entry.label);

// Weekly collection batches (data/weekly), used for the KPIs.
const groups = groupByWeek(caseStudies);
const datedGroups = groups.filter((group) => group.week !== UNDATED_WEEK);
const latestWeek = datedGroups[0];
const lastCollected = caseStudies
  .map((record) => record.collected_at ?? "")
  .filter(Boolean)
  .sort()
  .at(-1);

const latestStories = sortByRecency(realRecords.length > 0 ? realRecords : caseStudies).slice(0, 4);
const latestGrid = sortNewest(realRecords.length > 0 ? realRecords : caseStudies).slice(0, 12);
const quickUseCases = topUseCases.slice(0, 5);
const explore = (param: string, value: string) => href(`/explore/?${param}=${encodeURIComponent(value)}`);

const methodSteps = [
  {
    title: "Track",
    text: "New customer stories are picked up from leading cloud and AI vendors every day, newest first.",
    svg: `<circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8 5v3.2l2.2 1.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>`,
  },
  {
    title: "Trace",
    text: "Claims are linked to named sources, publication dates and retrieval timestamps so provenance stays visible.",
    svg: `<path d="M6.5 9.5 5 11a2.5 2.5 0 1 1-3.5-3.5l2.2-2.2a2.5 2.5 0 0 1 3.5 0M9.5 6.5 11 5a2.5 2.5 0 1 1 3.5 3.5l-2.2 2.2a2.5 2.5 0 0 1-3.5 0M6.2 9.8l3.6-3.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>`,
  },
  {
    title: "Score",
    text: "Evidence confidence and customer reference value are scored separately with a visible, deterministic rubric.",
    svg: `<path d="M8 2.2 13.2 4.2v4c0 3.4-2.2 5.6-5.2 6.6-3-1-5.2-3.2-5.2-6.6v-4L8 2.2Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="m6 8.2 1.5 1.5 2.8-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
  {
    title: "Compare",
    text: "Use consistent problems, architectures, products and outcomes to find repeatable patterns—not just polished stories.",
    svg: `<rect x="2.2" y="3" width="4.8" height="10" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="9" y="3" width="4.8" height="10" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/>`,
  },
];
---

<BaseLayout title="Use Case Intelligence — real-world AI customer stories">
  <main>
    <section class="hero">
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="hero__grid" aria-hidden="true"></div>
      <div class="container hero__inner">
        <div class="hero__copy">
          <span class="pill pill--live"><span class="pill__dot" aria-hidden="true"></span>Live · refreshed daily from {vendors.length} vendors</span>
          <h1 class="hero__title">
            Find AI deployments <span class="text-gradient">worth learning from.</span>
          </h1>
          <p class="hero__lead">
            For strategy, product, architecture and go-to-market teams: turn scattered customer stories from
            {` ${leadVendors.join(", ")}`} and more into comparable evidence about the problem solved, what was built,
            and whether the reported value is credible.
          </p>

          <form class="hero-search" action={href("/explore/")} method="get" role="search">
            <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M8.5 3a5.5 5.5 0 014.38 8.83l3.65 3.64a.75.75 0 01-1.06 1.06l-3.64-3.65A5.5 5.5 0 118.5 3zm0 1.5a4 4 0 100 8 4 4 0 000-8z"/></svg>
            <label class="sr-only" for="hero-q">Search use cases</label>
            <input id="hero-q" name="q" type="search" placeholder="Search customers, products, problems…" autocomplete="off" />
            <button class="btn btn--primary" type="submit">Search</button>
          </form>

          <div class="hero__quick">
            <span>Start with:</span>
            {quickUseCases.map((entry) => (
              <a class="chip chip--glass" href={facetHref("use-cases", entry.label)}>{entry.label}</a>
            ))}
          </div>
          <div class="hero__data-links">
            <span>Updates</span>
            <a href={href("/feed.xml")}>Follow the RSS feed</a>
          </div>
        </div>

        <aside class="latest-panel" aria-label="Latest stories">
          <div class="latest-panel__head">
            <span>Latest arrivals</span>
            {lastCollected && <span class="latest-panel__stamp">Updated {formatDate(lastCollected.slice(0, 10))}</span>}
          </div>
          <ul class="latest-list">
            {latestStories.map((record) => {
              const style = vendorStyle(record.vendor);
              return (
                <li>
                  <a class="latest-item" href={caseHref(record.slug)}>
                    <span class="vendor-tag__mark vendor-tag__mark--lg" style={`--vendor: ${style.color}`} set:html={vendorLogoSvg(record.vendor, style.mark)} />
                    <span class="latest-item__body">
                      <span class="latest-item__title">{record.customer_name}</span>
                      <span class="latest-item__meta">{record.vendor} · {record.use_case_category[0] ?? record.industry}</span>
                      {headlineMetric(record) && <span class="latest-item__metric">{headlineMetric(record)}</span>}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </aside>
      </div>

      <div class="container">
        <dl class="kpi-row">
          <div class="kpi">
            <dt>Customer stories</dt>
            <dd>{realRecords.length || caseStudies.length}</dd>
          </div>
          <div class="kpi">
            <dt>Vendors tracked</dt>
            <dd>{vendors.length}</dd>
          </div>
          <div class="kpi">
            <dt>Industries</dt>
            <dd>{industries.length}</dd>
          </div>
          <div class="kpi">
            <dt>In latest weekly batch</dt>
            <dd>{latestWeek ? latestWeek.records.length : 0}</dd>
          </div>
          <div class="kpi">
            <dt>Weekly archives</dt>
            <dd>{datedGroups.length}</dd>
          </div>
        </dl>

        <ul class="vendor-strip" aria-label="Stories per vendor">
          {stripVendors.map((entry) => {
            const style = vendorStyle(entry.label);
            return (
              <li>
                <a class="vendor-strip__item" href={facetHref("vendors", entry.label)}>
                  <span class="vendor-tag__mark" style={`--vendor: ${style.color}`} set:html={vendorLogoSvg(entry.label, style.mark)} />
                  <span>{entry.label}</span>
                  <span class="vendor-strip__count">{entry.count}</span>
                </a>
              </li>
            );
          })}
          {tailVendors > 0 && (
            <li>
              <a class="vendor-strip__item vendor-strip__item--more" href={href("/vendors/")}>
                <span>+{tailVendors} more vendors</span>
              </a>
            </li>
          )}
        </ul>
      </div>
    </section>

    <section class="section decision-section" id="about">
      <div class="container">
        <div class="section__head">
          <div>
            <p class="eyebrow">The decision problem</p>
            <h2 class="section__title">From marketing claims to usable customer evidence</h2>
          </div>
          <p class="section__subtitle">
            Use the library to shortlist relevant deployments, inspect the architecture and outcome, then validate every important fact against its source before applying the pattern to your customer.
          </p>
        </div>
        <div class="decision-grid">
          <article class="decision-card">
            <div class="decision-card__top">
              <span class="decision-card__index">01</span>
              <span class="decision-card__icon" aria-hidden="true">
                <svg viewBox="0 0 20 20" width="18" height="18"><circle cx="10" cy="7" r="3.2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M4.2 16.5a5.8 5.8 0 0 1 11.6 0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
              </span>
            </div>
            <h3>Who it is for</h3>
            <p>AI strategy, product, architecture, sales and research teams evaluating what has actually been deployed for customers like theirs.</p>
          </article>
          <article class="decision-card">
            <div class="decision-card__top">
              <span class="decision-card__index">02</span>
              <span class="decision-card__icon" aria-hidden="true">
                <svg viewBox="0 0 20 20" width="18" height="18"><path d="M3.5 5.5h13M5.5 10h9M8 14.5h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              </span>
            </div>
            <h3>How to use it</h3>
            <p>Filter by industry or use case, compare customer reference value, inspect the confidence breakdown, and open the cited sources before making a recommendation.</p>
          </article>
          <article class="decision-card decision-card--data">
            <div class="decision-card__top">
              <span class="decision-card__index">03</span>
              <span class="decision-card__icon" aria-hidden="true">
                <svg viewBox="0 0 20 20" width="18" height="18"><circle cx="5" cy="15" r="1.8" fill="currentColor"/><path d="M3.5 9.5A7 7 0 0 1 10.5 16.5M3.5 4.5a12 12 0 0 1 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              </span>
            </div>
            <h3>How to stay current</h3>
            <p>Subscribe to RSS for newly collected stories; the catalog refreshes daily and retains retrieval timestamps.</p>
            <div class="decision-card__actions">
              <a class="btn btn--secondary btn--small" href={href("/feed.xml")}>Subscribe via RSS</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="latest">
      <div class="container">
        <div class="section__head">
          <div>
            <p class="eyebrow">Latest</p>
            <h2 class="section__title">Newest customer use cases</h2>
          </div>
          <div class="section__actions">
            <a class="btn btn--secondary" href={href("/browse/")}>Browse all {caseStudies.length.toLocaleString("en")}</a>
            <a class="btn btn--primary" href={href("/explore/")}>Search &amp; filter</a>
          </div>
        </div>

        <div class="card-grid">
          {latestGrid.map((record) => <CaseCard card={toCardRecord(record)} />)}
        </div>
        <div class="browse-links">
          <span>Browse by</span>
          <a class="chip" href={href("/vendors/")}>Vendor</a>
          <a class="chip" href={href("/industries/")}>Industry</a>
          <a class="chip" href={href("/use-cases/")}>Use case</a>
        </div>
        {sampleCount > 0 && (
          <p class="footnote">{sampleCount} illustrative sample {sampleCount === 1 ? "profile is" : "profiles are"} marked “Sample” and excluded from insights.</p>
        )}
      </div>
    </section>

    <section class="section section--tinted" id="insights">
      <div class="container">
        <div class="section__head">
          <div>
            <p class="eyebrow">Insights</p>
            <h2 class="section__title">Where AI delivers customer value</h2>
          </div>
          <div class="section__actions">
            <a class="btn btn--primary" href={href("/insights/")}>See all insights</a>
          </div>
        </div>

        <div class="insight-grid">
          <article class="panel">
            <header class="panel__head">
              <h3>Top use-case categories</h3>
              <span class="panel__meta">stories per category</span>
            </header>
            <BarList items={topUseCases} noun="stories" linkTo={(label) => explore("usecase", label)} />
          </article>

          <article class="panel">
            <header class="panel__head">
              <h3>Top industries</h3>
              <span class="panel__meta">stories per industry</span>
            </header>
            <BarList items={industryCounts.slice(0, 8)} noun="stories" linkTo={(label) => explore("industry", label)} />
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="method">
      <div class="container">
        <div class="section__head">
          <div>
            <p class="eyebrow">Methodology</p>
            <h2 class="section__title">Transparent by design</h2>
          </div>
          <p class="section__subtitle">
            Scores expose the strength and traceability of available evidence, not certainty or guaranteed ROI. A complete first-party source can score well without an artificial multi-source requirement.
          </p>
        </div>
        <ol class="steps">
          {methodSteps.map((step, index) => (
            <li class="step">
              <div class="step__head">
                <span class="step__index">{String(index + 1).padStart(2, "0")}</span>
                <span class="step__icon" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="18" height="18" set:html={step.svg} />
                </span>
              </div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
        <div class="cta">
          <div>
            <h2 class="cta__title">Find the strongest reference for your customer.</h2>
            <p class="cta__text">Search by vendor, industry, use case or product, then compare value, evidence confidence, architecture and source provenance side by side.</p>
          </div>
          <div class="cta__actions">
            <a class="btn btn--primary" href={href("/explore/")}>Explore use cases</a>
            <a class="btn btn--glass" href={href("/insights/")}>See insights</a>
          </div>
        </div>
      </div>
    </section>
  </main>

</BaseLayout>
