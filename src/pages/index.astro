---
import BarList from "../components/BarList.astro";
import CaseCard from "../components/CaseCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  buildMatrix,
  countValues,
  flattenValues,
  formatDate,
  headlineMetric,
  sortByRecency,
  topValues,
  uniqueSorted,
} from "../lib/analytics";
import { caseStudies } from "../lib/caseStudies";
import { facetHref, sortNewest } from "../lib/facets";
import { caseHref, href } from "../lib/paths";
import { groupByWeek, toCardRecord, UNDATED_WEEK, weekShortLabel } from "../lib/weeks";
import { vendorStyle } from "../lib/vendors";

// Insights describe the real market signal; synthetic seed rows only count
// when nothing has been extracted yet.
const realRecords = caseStudies.filter((record) => !record.is_sample);
const signal = realRecords.length > 0 ? realRecords : caseStudies;
const sampleCount = caseStudies.length - realRecords.length;

const vendors = uniqueSorted(caseStudies.map((record) => record.vendor));
const industries = uniqueSorted(caseStudies.map((record) => record.industry));

const vendorCounts = countValues(signal.map((record) => record.vendor));
const industryCounts = countValues(signal.map((record) => record.industry));
const topUseCases = topValues(flattenValues(signal, (record) => record.use_case_category), 8);
const topProducts = topValues(flattenValues(signal, (record) => record.products_used), 8);
const topOutcomes = topValues(flattenValues(signal, (record) => record.outcome_category), 8);

// Weekly collection batches (data/weekly), used for the cadence chart and KPIs.
const groups = groupByWeek(caseStudies);
const datedGroups = groups.filter((group) => group.week !== UNDATED_WEEK);
const latestWeek = datedGroups[0];
const lastCollected = caseStudies
  .map((record) => record.collected_at ?? "")
  .filter(Boolean)
  .sort()
  .at(-1);

// Collection cadence: real records per week, oldest → newest, last 12 weeks.
const cadence = datedGroups
  .slice(0, 12)
  .reverse()
  .map((group) => ({
    week: group.week,
    label: weekShortLabel(group.week),
    count: group.records.filter((record) => !record.is_sample).length,
  }));
const cadenceMax = cadence.reduce((highest, entry) => Math.max(highest, entry.count), 1);

// Industry × use-case heatmap over the top use cases (sequential blue ramp).
const heatColumns = topUseCases.map((entry) => entry.label);
const heatRows = buildMatrix(
  signal,
  industryCounts.map((entry) => entry.label),
  heatColumns,
  (record) => [record.industry],
  (record) => record.use_case_category,
).filter((row) => row.total > 0);
const heatMax = heatRows.reduce(
  (highest, row) => Math.max(highest, ...row.cells.map((cell) => cell.count)),
  1,
);
const HEAT_RAMP = ["#cde2fb", "#9ec5f4", "#6da7ec", "#3987e5", "#256abf", "#184f95"];
function heatStep(count: number): number {
  if (count <= 0) return -1;
  if (heatMax <= 1) return 0;
  return Math.round(((count - 1) / (heatMax - 1)) * (HEAT_RAMP.length - 1));
}

const latestStories = sortByRecency(realRecords.length > 0 ? realRecords : caseStudies).slice(0, 4);
const latestGrid = sortNewest(realRecords.length > 0 ? realRecords : caseStudies).slice(0, 12);
const quickUseCases = topUseCases.slice(0, 5);
const explore = (param: string, value: string) => href(`/explore/?${param}=${encodeURIComponent(value)}`);

const methodSteps = [
  { title: "Track", text: "New customer stories are picked up from leading cloud and AI vendors every day, newest first." },
  { title: "Read", text: "Each story is read end to end — architecture details, measurable results and customer quotes included." },
  { title: "Structure", text: "Every story becomes a consistent profile: business problem, solution architecture, products, outcomes and evidence." },
  { title: "Compare", text: "Profiles are scored for maturity and grouped by week, so you can compare deployments across vendors and industries." },
];
---

<BaseLayout title="Use Case Intelligence — real-world cloud & AI customer stories">
  <main>
    <section class="hero">
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="hero__grid" aria-hidden="true"></div>
      <div class="container hero__inner">
        <div class="hero__copy">
          <span class="pill pill--live"><span class="pill__dot" aria-hidden="true"></span>Live · refreshed daily from {vendors.length} vendors</span>
          <h1 class="hero__title">
            Real-world cloud &amp; AI use cases, <span class="text-gradient">decoded.</span>
          </h1>
          <p class="hero__lead">
            Customer stories from {vendors.slice(0, 5).join(", ")} and more — collected every day and normalized
            into problems, architectures, products and measurable outcomes you can compare side by side.
          </p>

          <form class="hero-search" action={href("/explore/")} method="get" role="search">
            <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M8.5 3a5.5 5.5 0 014.38 8.83l3.65 3.64a.75.75 0 01-1.06 1.06l-3.64-3.65A5.5 5.5 0 118.5 3zm0 1.5a4 4 0 100 8 4 4 0 000-8z"/></svg>
            <label class="sr-only" for="hero-q">Search use cases</label>
            <input id="hero-q" name="q" type="search" placeholder="Search customers, products, problems…" autocomplete="off" />
            <button class="btn btn--primary" type="submit">Search</button>
          </form>

          <div class="hero__quick">
            <span>Popular:</span>
            {quickUseCases.map((entry) => (
              <a class="chip chip--glass" href={facetHref("use-cases", entry.label)}>{entry.label}</a>
            ))}
          </div>
        </div>

        <aside class="latest-panel" aria-label="Latest stories">
          <div class="latest-panel__head">
            <span>Latest arrivals</span>
            {lastCollected && <span class="latest-panel__stamp">Updated {formatDate(lastCollected.slice(0, 10))}</span>}
          </div>
          <ul class="latest-list">
            {latestStories.map((record) => {
              const style = vendorStyle(record.vendor);
              return (
                <li>
                  <a class="latest-item" href={caseHref(record.slug)}>
                    <span class="vendor-tag__mark vendor-tag__mark--lg" style={`--vendor: ${style.color}`}>{style.mark}</span>
                    <span class="latest-item__body">
                      <span class="latest-item__title">{record.customer_name}</span>
                      <span class="latest-item__meta">{record.vendor} · {record.use_case_category[0] ?? record.industry}</span>
                      {headlineMetric(record) && <span class="latest-item__metric">{headlineMetric(record)}</span>}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </aside>
      </div>

      <div class="container">
        <dl class="kpi-row">
          <div class="kpi">
            <dt>Customer stories</dt>
            <dd>{realRecords.length || caseStudies.length}</dd>
          </div>
          <div class="kpi">
            <dt>Vendors tracked</dt>
            <dd>{vendors.length}</dd>
          </div>
          <div class="kpi">
            <dt>Industries</dt>
            <dd>{industries.length}</dd>
          </div>
          <div class="kpi">
            <dt>In latest weekly batch</dt>
            <dd>{latestWeek ? latestWeek.records.length : 0}</dd>
          </div>
          <div class="kpi">
            <dt>Weekly archives</dt>
            <dd>{datedGroups.length}</dd>
          </div>
        </dl>

        <ul class="vendor-strip" aria-label="Stories per vendor">
          {vendorCounts.map((entry) => {
            const style = vendorStyle(entry.label);
            return (
              <li>
                <a class="vendor-strip__item" href={facetHref("vendors", entry.label)}>
                  <span class="vendor-tag__mark" style={`--vendor: ${style.color}`}>{style.mark}</span>
                  <span>{entry.label}</span>
                  <span class="vendor-strip__count">{entry.count}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <section class="section" id="latest">
      <div class="container">
        <div class="section__head">
          <div>
            <p class="eyebrow">Latest</p>
            <h2 class="section__title">Newest customer use cases</h2>
          </div>
          <div class="section__actions">
            <a class="btn btn--secondary" href={href("/browse/")}>Browse all {caseStudies.length.toLocaleString("en")}</a>
            <a class="btn btn--primary" href={href("/explore/")}>Search &amp; filter</a>
          </div>
        </div>

        <div class="card-grid">
          {latestGrid.map((record) => <CaseCard card={toCardRecord(record)} />)}
        </div>
        <div class="browse-links">
          <span>Browse by</span>
          <a class="chip" href={href("/vendors/")}>Vendor</a>
          <a class="chip" href={href("/industries/")}>Industry</a>
          <a class="chip" href={href("/use-cases/")}>Use case</a>
        </div>
        {sampleCount > 0 && (
          <p class="footnote">{sampleCount} illustrative sample {sampleCount === 1 ? "profile is" : "profiles are"} marked “Sample” and excluded from insights.</p>
        )}
      </div>
    </section>

    <section class="section section--tinted" id="insights">
      <div class="container">
        <div class="section__head">
          <div>
            <p class="eyebrow">Insights</p>
            <h2 class="section__title">Where vendors prove customer value</h2>
          </div>
          <p class="section__subtitle">
            Aggregated across {signal.length} customer stories. Click any bar to filter the explorer.
          </p>
        </div>

        <div class="insight-grid">
          <article class="panel">
            <header class="panel__head">
              <h3>Top use-case categories</h3>
              <span class="panel__meta">stories per category</span>
            </header>
            <BarList items={topUseCases} noun="stories" linkTo={(label) => explore("usecase", label)} />
          </article>

          <article class="panel">
            <header class="panel__head">
              <h3>Stories by vendor</h3>
              <span class="panel__meta">stories per vendor</span>
            </header>
            <BarList items={vendorCounts.slice(0, 8)} noun="stories" linkTo={(label) => explore("vendor", label)} />
          </article>

          <article class="panel">
            <header class="panel__head">
              <h3>Most-cited products</h3>
              <span class="panel__meta">mentions across stories</span>
            </header>
            <BarList items={topProducts} noun="mentions" linkTo={(label) => explore("q", label)} />
          </article>

          <article class="panel">
            <header class="panel__head">
              <h3>Business outcomes claimed</h3>
              <span class="panel__meta">stories per outcome</span>
            </header>
            <BarList items={topOutcomes} noun="stories" />
          </article>

          {cadence.length > 1 && (
            <article class="panel panel--wide">
              <header class="panel__head">
                <h3>Collection cadence</h3>
                <span class="panel__meta">new stories per collection week</span>
              </header>
              <div class="columns" role="img" aria-label={`New stories per week, latest week ${cadence.at(-1)?.count ?? 0}`}>
                {cadence.map((entry, index) => (
                  <div class="columns__col" tabindex="0" data-tip={`Week of ${entry.label}: ${entry.count} new ${entry.count === 1 ? "story" : "stories"}`}>
                    <span class="columns__bar" style={`height: ${Math.max(2, (entry.count / cadenceMax) * 100)}%`}>
                      <span class="columns__value">{index === cadence.length - 1 || entry.count === cadenceMax ? entry.count : ""}</span>
                    </span>
                    <span class="columns__label">{entry.label}</span>
                  </div>
                ))}
              </div>
              <table class="sr-only">
                <caption>New stories per collection week</caption>
                <thead><tr><th>Week of</th><th>Stories</th></tr></thead>
                <tbody>{cadence.map((entry) => <tr><td>{entry.label}</td><td>{entry.count}</td></tr>)}</tbody>
              </table>
            </article>
          )}

          <article class="panel panel--wide">
            <header class="panel__head">
              <h3>Industry × use case coverage</h3>
              <div class="heat-legend" aria-hidden="true">
                <span>1</span>
                {HEAT_RAMP.map((color) => <span class="heat-legend__swatch" style={`background: ${color}`}></span>)}
                <span>{heatMax}</span>
                <span class="heat-legend__caption">stories</span>
              </div>
            </header>
            <div class="heatmap-scroll">
              <table class="heatmap">
                <thead>
                  <tr>
                    <th scope="col">Industry</th>
                    {heatColumns.map((column) => <th scope="col"><span>{column}</span></th>)}
                    <th scope="col">Total</th>
                  </tr>
                </thead>
                <tbody>
                  {heatRows.map((row) => (
                    <tr>
                      <th scope="row">{row.label}</th>
                      {row.cells.map((cell) => {
                        const step = heatStep(cell.count);
                        return (
                          <td
                            class:list={["heatmap__cell", { "is-empty": step < 0, "is-dark": step >= 3 }]}
                            style={step >= 0 ? `background: ${HEAT_RAMP[step]}` : undefined}
                            tabindex={step >= 0 ? 0 : undefined}
                            data-tip={step >= 0 ? `${row.label} × ${cell.label}: ${cell.count} ${cell.count === 1 ? "story" : "stories"}` : undefined}
                          >
                            {cell.count || ""}
                          </td>
                        );
                      })}
                      <td class="heatmap__total">{row.total}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="method">
      <div class="container">
        <div class="section__head">
          <div>
            <p class="eyebrow">Methodology</p>
            <h2 class="section__title">From customer story to comparable insight</h2>
          </div>
          <p class="section__subtitle">
            The library refreshes every day. Each new story is turned into a structured profile, so you can see what was built, with which products, and what it delivered.
          </p>
        </div>
        <ol class="steps">
          {methodSteps.map((step, index) => (
            <li class="step">
              <span class="step__index">{String(index + 1).padStart(2, "0")}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
        <div class="cta">
          <div>
            <h2 class="cta__title">Find proven patterns for your next project.</h2>
            <p class="cta__text">Search by vendor, industry, use case or product, and go straight to the architecture and outcomes behind each deployment.</p>
          </div>
          <div class="cta__actions">
            <a class="btn btn--primary" href="#explore">Explore use cases</a>
            <a class="btn btn--glass" href="#insights">See insights</a>
          </div>
        </div>
      </div>
    </section>
  </main>

</BaseLayout>
