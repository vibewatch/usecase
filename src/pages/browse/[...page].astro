---
import type { GetStaticPaths, Page } from "astro";
import CaseListing from "../../components/CaseListing.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { caseStudies } from "../../lib/caseStudies";
import { PAGE_SIZE, sortNewest } from "../../lib/facets";
import { href } from "../../lib/paths";
import type { CaseStudyRecord } from "../../lib/types";

export const getStaticPaths = (({ paginate }) =>
  paginate(sortNewest(caseStudies), { pageSize: PAGE_SIZE })) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<CaseStudyRecord> };
---

<BaseLayout title={`All use cases${page.currentPage > 1 ? ` — page ${page.currentPage}` : ""} | Use Case Intelligence`}>
  <main>
    <section class="page-hero">
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="container page-hero__inner">
        <p class="eyebrow eyebrow--light">Browse</p>
        <h1 class="page-hero__title">All customer use cases</h1>
        <p class="hero__lead">Newest first. Need something specific? <a class="text-link" href={href("/explore/")}>Search and filter →</a></p>
      </div>
    </section>
    <section class="section section--compact">
      <div class="container">
        <CaseListing
          records={page.data}
          currentPage={page.currentPage}
          lastPage={page.lastPage}
          total={page.total}
          start={page.start}
          pageUrl={(number) => href(number === 1 ? "/browse/" : `/browse/${number}/`)}
        />
      </div>
    </section>
  </main>
</BaseLayout>
