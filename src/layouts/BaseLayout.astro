---
import "../styles/global.css";
import { href } from "../lib/paths";

type Props = {
  title: string;
  description?: string;
};

const {
  title,
  description = "Real-world AI customer use cases from AWS, Microsoft, Google Cloud, OpenAI, NVIDIA and more — collected daily and normalized into problems, architectures, products and outcomes.",
} = Astro.props;
const year = new Date().getFullYear();
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060816" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={href("/favicon.svg")} />
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" data-site-header>
      <div class="container site-nav">
        <a class="brand" href={href("/")}>
          <img class="brand__mark" src={href("/favicon.svg")} alt="" width="32" height="32" />
          <span class="brand__name">Use Case <strong>Intelligence</strong></span>
        </a>
        <nav aria-label="Primary">
          <ul class="nav-links">
            <li><a href={href("/explore/")}>Explore</a></li>
            <li><a href={href("/vendors/")}>Vendors</a></li>
            <li><a href={href("/use-cases/")}>Use cases</a></li>
            <li><a href={href("/#insights")}>Insights</a></li>
          </ul>
        </nav>
        <a class="btn btn--primary btn--small" href={href("/explore/")}>Search use cases</a>
      </div>
    </header>

    <div id="main">
      <slot />
    </div>

    <footer class="site-footer">
      <div class="container site-footer__grid">
        <div class="site-footer__brand">
          <a class="brand" href={href("/")}>
            <img class="brand__mark" src={href("/favicon.svg")} alt="" width="32" height="32" />
            <span class="brand__name">Use Case <strong>Intelligence</strong></span>
          </a>
          <p>Vendor customer stories, collected daily and normalized into a comparable market signal.</p>
        </div>
        <div class="site-footer__col">
          <h2>Explore</h2>
          <ul>
            <li><a href={href("/explore/")}>Search &amp; filter</a></li>
            <li><a href={href("/browse/")}>All use cases</a></li>
            <li><a href={href("/#insights")}>Market insights</a></li>
            <li><a href={href("/#method")}>Methodology</a></li>
          </ul>
        </div>
        <div class="site-footer__col">
          <h2>Browse by</h2>
          <ul>
            <li><a href={href("/vendors/")}>Vendor</a></li>
            <li><a href={href("/industries/")}>Industry</a></li>
            <li><a href={href("/use-cases/")}>Use case</a></li>
          </ul>
        </div>
      </div>
      <div class="container site-footer__legal">
        <span>© {year} Use Case Intelligence. Case study content belongs to the respective vendors and customers.</span>
        <span>Refreshed daily</span>
      </div>
    </footer>

    <div class="tooltip" role="tooltip" data-tooltip hidden></div>

    <script>
      const header = document.querySelector("[data-site-header]");
      const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 8);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      // Shared hover/focus tooltip for chart marks ([data-tip]). Values are
      // always visible elsewhere, so the tooltip only enhances.
      const tooltip = document.querySelector<HTMLElement>("[data-tooltip]");
      function placeTooltip(target: HTMLElement) {
        if (!tooltip) return;
        const text = target.dataset.tip;
        if (!text) return;
        tooltip.textContent = text;
        tooltip.hidden = false;
        const rect = target.getBoundingClientRect();
        const tip = tooltip.getBoundingClientRect();
        const left = Math.min(
          window.innerWidth - tip.width - 8,
          Math.max(8, rect.left + rect.width / 2 - tip.width / 2),
        );
        const above = rect.top - tip.height - 8;
        tooltip.style.left = `${left}px`;
        tooltip.style.top = `${above > 8 ? above : rect.bottom + 8}px`;
      }
      function hideTooltip() {
        if (tooltip) tooltip.hidden = true;
      }
      for (const type of ["mouseover", "focusin"] as const) {
        document.addEventListener(type, (event) => {
          const target = event.target instanceof Element ? event.target.closest<HTMLElement>("[data-tip]") : null;
          if (target) placeTooltip(target);
          else hideTooltip();
        });
      }
      document.addEventListener("focusout", hideTooltip);
      window.addEventListener("scroll", hideTooltip, { passive: true });
    </script>
  </body>
</html>
