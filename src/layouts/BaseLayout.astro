---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/instrument-sans";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { href } from "../lib/paths";

type Props = {
  title: string;
  description?: string;
};

const {
  title,
  description = "Real-world AI customer use cases from AWS, Microsoft, Google Cloud, OpenAI, NVIDIA and more — collected daily and normalized into problems, architectures, products and outcomes.",
} = Astro.props;
const year = new Date().getFullYear();
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1714" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title="Use Case Intelligence — latest use cases" href={href("/feed.xml")} />
    <link rel="icon" type="image/svg+xml" href={`${href("/favicon.svg")}?v=2`} />
    <title>{title}</title>
    {import.meta.env.PROD && (
      <>
        {/* Google Analytics (GA4) in basic consent mode: gtag.js is loaded and cookies are
            set only after the visitor accepts the banner. Production builds only. */}
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag("consent", "default", {
            ad_storage: "denied",
            ad_user_data: "denied",
            ad_personalization: "denied",
            analytics_storage: "denied",
          });
          gtag("js", new Date());
          gtag("config", "G-0QQZ5LMYSD");
          window.ucLoadAnalytics = function () {
            gtag("consent", "update", { analytics_storage: "granted" });
            if (window.ucAnalyticsLoaded) return;
            window.ucAnalyticsLoaded = true;
            var script = document.createElement("script");
            script.async = true;
            script.src = "https://www.googletagmanager.com/gtag/js?id=G-0QQZ5LMYSD";
            document.head.appendChild(script);
          };
          try {
            if (localStorage.getItem("uc-analytics-consent") === "granted") window.ucLoadAnalytics();
          } catch (error) {}
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" data-site-header>
      <div class="container site-nav">
        <a class="brand" href={href("/")}>
          <img class="brand__mark" src={`${href("/favicon.svg")}?v=2`} alt="" width="32" height="32" />
          <span class="brand__name">Use Case <strong>Intelligence</strong></span>
        </a>
        <nav aria-label="Primary">
          <ul class="nav-links">
            <li><a href={href("/explore/")}>Explore</a></li>
            <li><a href={href("/vendors/")}>Vendors</a></li>
            <li><a href={href("/use-cases/")}>Use cases</a></li>
            <li><a href={href("/insights/")}>Insights</a></li>
          </ul>
        </nav>
        <a class="btn btn--primary btn--small" href={href("/explore/")}>Search use cases</a>
      </div>
    </header>

    <div id="main">
      <slot />
    </div>

    <footer class="site-footer">
      <div class="container site-footer__grid">
        <div class="site-footer__brand">
          <a class="brand" href={href("/")}>
            <img class="brand__mark" src={`${href("/favicon.svg")}?v=2`} alt="" width="32" height="32" />
            <span class="brand__name">Use Case <strong>Intelligence</strong></span>
          </a>
          <p>Vendor customer stories, collected daily and normalized into a comparable market signal.</p>
        </div>
        <div class="site-footer__col">
          <h2>Explore</h2>
          <ul>
            <li><a href={href("/explore/")}>Search &amp; filter</a></li>
            <li><a href={href("/browse/")}>All use cases</a></li>
            <li><a href={href("/insights/")}>Market insights</a></li>
            <li><a href={href("/#method")}>Methodology</a></li>
            <li><a href={href("/data.json")}>Download JSON</a></li>
            <li><a href={href("/feed.xml")}>RSS updates</a></li>
          </ul>
        </div>
        <div class="site-footer__col">
          <h2>Browse by</h2>
          <ul>
            <li><a href={href("/vendors/")}>Vendor</a></li>
            <li><a href={href("/industries/")}>Industry</a></li>
            <li><a href={href("/use-cases/")}>Use case</a></li>
          </ul>
        </div>
      </div>
      <div class="container site-footer__legal">
        <span>© {year} Use Case Intelligence. Case study content belongs to the respective vendors and customers.</span>
        <span class="site-footer__credit">
          {import.meta.env.PROD && <><button class="site-footer__link" type="button" data-consent-open>Cookie settings</button> · </>}
          Refreshed daily · Built by
          <a href="https://www.linkedin.com/in/yingting-huang-9622bb20/" target="_blank" rel="noopener noreferrer" aria-label="Yingting Huang on LinkedIn">
            Yingting Huang
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M2 1.5h12A.5.5 0 0 1 14.5 2v12a.5.5 0 0 1-.5.5H2a.5.5 0 0 1-.5-.5V2A.5.5 0 0 1 2 1.5Zm2.2 4.6v6.1h1.9V6.1H4.2Zm.95-3a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2Zm2.45 3v6.1h1.9V9.2c0-.8.15-1.6 1.15-1.6.98 0 .99.92.99 1.65v2.95h1.9V8.9c0-1.62-.35-2.87-2.24-2.87-.91 0-1.52.5-1.77.97h-.03v-.9H7.6Z"/></svg>
          </a>
        </span>
      </div>
    </footer>

    <div class="tooltip" role="tooltip" data-tooltip hidden></div>

    {import.meta.env.PROD && (
      <>
        <section class="consent" role="dialog" aria-labelledby="consent-title" aria-describedby="consent-text" data-consent hidden>
          <h2 class="consent__title" id="consent-title">Cookies, briefly</h2>
          <p class="consent__text" id="consent-text">
            With your OK, we use Google Analytics cookies to see which pages and searches are useful. No ads, no profiling, and
            nothing is loaded until you accept. You can change this any time under “Cookie settings” in the footer.
          </p>
          <div class="consent__actions">
            <button class="btn btn--primary btn--small" type="button" data-consent-choice="granted">Accept analytics</button>
            <button class="btn btn--secondary btn--small" type="button" data-consent-choice="denied">Decline</button>
          </div>
        </section>
        <script is:inline>
          (function () {
            var KEY = "uc-analytics-consent";
            var banner = document.querySelector("[data-consent]");
            if (!banner) return;
            var stored = null;
            try { stored = localStorage.getItem(KEY); } catch (error) {}
            if (stored !== "granted" && stored !== "denied") banner.hidden = false;

            function clearAnalyticsCookies() {
              var host = location.hostname;
              var domains = ["", host, "." + host, "." + host.split(".").slice(-2).join(".")];
              document.cookie.split(";").forEach(function (cookie) {
                var name = cookie.split("=")[0].trim();
                if (name !== "_ga" && name.indexOf("_ga_") !== 0) return;
                domains.forEach(function (domain) {
                  document.cookie = name + "=; Max-Age=0; path=/" + (domain ? "; domain=" + domain : "");
                });
              });
            }

            banner.addEventListener("click", function (event) {
              var button = event.target.closest("[data-consent-choice]");
              if (!button) return;
              var choice = button.getAttribute("data-consent-choice");
              try { localStorage.setItem(KEY, choice); } catch (error) {}
              if (choice === "granted") {
                window.ucLoadAnalytics();
              } else {
                gtag("consent", "update", { analytics_storage: "denied" });
                clearAnalyticsCookies();
              }
              banner.hidden = true;
            });

            document.addEventListener("click", function (event) {
              if (!event.target.closest("[data-consent-open]")) return;
              banner.hidden = false;
              var first = banner.querySelector("button");
              if (first) first.focus();
            });
          })();
        </script>
      </>
    )}

    <script>
      const header = document.querySelector("[data-site-header]");
      const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 8);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      // Shared hover/focus tooltip for chart marks ([data-tip]). Values are
      // always visible elsewhere, so the tooltip only enhances.
      const tooltip = document.querySelector<HTMLElement>("[data-tooltip]");
      function placeTooltip(target: HTMLElement) {
        if (!tooltip) return;
        const text = target.dataset.tip;
        if (!text) return;
        tooltip.textContent = text;
        tooltip.hidden = false;
        const rect = target.getBoundingClientRect();
        const tip = tooltip.getBoundingClientRect();
        const left = Math.min(
          window.innerWidth - tip.width - 8,
          Math.max(8, rect.left + rect.width / 2 - tip.width / 2),
        );
        const above = rect.top - tip.height - 8;
        tooltip.style.left = `${left}px`;
        tooltip.style.top = `${above > 8 ? above : rect.bottom + 8}px`;
      }
      function hideTooltip() {
        if (tooltip) tooltip.hidden = true;
      }
      for (const type of ["mouseover", "focusin"] as const) {
        document.addEventListener(type, (event) => {
          const target = event.target instanceof Element ? event.target.closest<HTMLElement>("[data-tip]") : null;
          if (target) placeTooltip(target);
          else hideTooltip();
        });
      }
      document.addEventListener("focusout", hideTooltip);
      window.addEventListener("scroll", hideTooltip, { passive: true });
    </script>
  </body>
</html>
