---
import "../styles/global.css";
import { href } from "../lib/paths";

type Props = {
  title: string;
  description?: string;
};

const {
  title,
  description = "Real-world cloud and AI customer use cases from AWS, Microsoft, Google Cloud, Oracle, Databricks and more — collected daily and normalized into problems, architectures, products and outcomes.",
} = Astro.props;
const year = new Date().getFullYear();
const repoUrl = "https://github.com/vibewatch/usecase";
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060816" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={href("/favicon.svg")} />
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" data-site-header>
      <div class="container site-nav">
        <a class="brand" href={href("/")}>
          <img class="brand__mark" src={href("/favicon.svg")} alt="" width="32" height="32" />
          <span class="brand__name">Use Case <strong>Intelligence</strong></span>
        </a>
        <nav aria-label="Primary">
          <ul class="nav-links">
            <li><a href={href("/#explore")}>Explore</a></li>
            <li><a href={href("/#insights")}>Insights</a></li>
            <li><a href={href("/#pipeline")}>How it works</a></li>
          </ul>
        </nav>
        <a class="btn btn--glass btn--small" href={repoUrl} target="_blank" rel="noreferrer">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
          <span>GitHub</span>
        </a>
      </div>
    </header>

    <div id="main">
      <slot />
    </div>

    <footer class="site-footer">
      <div class="container site-footer__grid">
        <div class="site-footer__brand">
          <a class="brand" href={href("/")}>
            <img class="brand__mark" src={href("/favicon.svg")} alt="" width="32" height="32" />
            <span class="brand__name">Use Case <strong>Intelligence</strong></span>
          </a>
          <p>Vendor customer stories, collected daily and normalized into a comparable market signal.</p>
        </div>
        <div class="site-footer__col">
          <h2>Explore</h2>
          <ul>
            <li><a href={href("/#explore")}>Use case explorer</a></li>
            <li><a href={href("/#insights")}>Market insights</a></li>
            <li><a href={href("/#pipeline")}>How it works</a></li>
          </ul>
        </div>
        <div class="site-footer__col">
          <h2>Data</h2>
          <ul>
            <li><a href={href("/data/weeks/index.json")}>Weekly shards (JSON)</a></li>
            <li><a href={`${repoUrl}/tree/main/data/weekly`} target="_blank" rel="noreferrer">Weekly archive on GitHub</a></li>
            <li><a href={`${repoUrl}/tree/main/data/records`} target="_blank" rel="noreferrer">Source records</a></li>
          </ul>
        </div>
        <div class="site-footer__col">
          <h2>Project</h2>
          <ul>
            <li><a href={repoUrl} target="_blank" rel="noreferrer">Repository</a></li>
            <li><a href={`${repoUrl}/actions`} target="_blank" rel="noreferrer">Daily collection runs</a></li>
            <li><a href={`${repoUrl}/issues`} target="_blank" rel="noreferrer">Report an issue</a></li>
          </ul>
        </div>
      </div>
      <div class="container site-footer__legal">
        <span>© {year} Use Case Intelligence. Case study content belongs to the respective vendors and customers.</span>
        <span>Refreshed daily · Built with Astro</span>
      </div>
    </footer>

    <div class="tooltip" role="tooltip" data-tooltip hidden></div>

    <script>
      const header = document.querySelector("[data-site-header]");
      const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 8);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      // Shared hover/focus tooltip for chart marks ([data-tip]). Values are
      // always visible elsewhere, so the tooltip only enhances.
      const tooltip = document.querySelector<HTMLElement>("[data-tooltip]");
      function placeTooltip(target: HTMLElement) {
        if (!tooltip) return;
        const text = target.dataset.tip;
        if (!text) return;
        tooltip.textContent = text;
        tooltip.hidden = false;
        const rect = target.getBoundingClientRect();
        const tip = tooltip.getBoundingClientRect();
        const left = Math.min(
          window.innerWidth - tip.width - 8,
          Math.max(8, rect.left + rect.width / 2 - tip.width / 2),
        );
        const above = rect.top - tip.height - 8;
        tooltip.style.left = `${left}px`;
        tooltip.style.top = `${above > 8 ? above : rect.bottom + 8}px`;
      }
      function hideTooltip() {
        if (tooltip) tooltip.hidden = true;
      }
      for (const type of ["mouseover", "focusin"] as const) {
        document.addEventListener(type, (event) => {
          const target = event.target instanceof Element ? event.target.closest<HTMLElement>("[data-tip]") : null;
          if (target) placeTooltip(target);
          else hideTooltip();
        });
      }
      document.addEventListener("focusout", hideTooltip);
      window.addEventListener("scroll", hideTooltip, { passive: true });
    </script>
  </body>
</html>
