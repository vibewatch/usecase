---
import type { CaseStudyRecord } from "../lib/types";
import { buildMatrix } from "../lib/analytics";

type Props = {
  records: CaseStudyRecord[];
  rowLabel: string;
  rows: string[];
  columns: string[];
  rowValues: (record: CaseStudyRecord) => string[];
  columnValues: (record: CaseStudyRecord) => string[];
};

// Sequential single-hue teal ramp (light -> dark = few -> many), validated with the
// dataviz ordinal checks against the paper surface; counts are direct-labeled.
const HEAT_RAMP = ["#72bdb0", "#47a596", "#1f8b7b", "#0f7364", "#095a4f", "#06413a"];
const { records, rowLabel, rows, columns, rowValues, columnValues } = Astro.props;
const matrix = buildMatrix(records, rows, columns, rowValues, columnValues).filter((row) => row.total > 0);
const max = matrix.reduce((highest, row) => Math.max(highest, ...row.cells.map((cell) => cell.count)), 1);
function step(count: number): number {
  if (count <= 0) return -1;
  if (max <= 1) return 0;
  return Math.round(((count - 1) / (max - 1)) * (HEAT_RAMP.length - 1));
}
---

<div class="heat-legend" aria-hidden="true">
  <span>1</span>
  {HEAT_RAMP.map((color) => <span class="heat-legend__swatch" style={`background: ${color}`}></span>)}
  <span>{max}</span>
  <span class="heat-legend__caption">stories</span>
</div>
<div class="heatmap-scroll">
  <table class="heatmap">
    <thead>
      <tr>
        <th scope="col">{rowLabel}</th>
        {columns.map((column) => <th scope="col"><span>{column}</span></th>)}
        <th scope="col">Total</th>
      </tr>
    </thead>
    <tbody>
      {matrix.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          {row.cells.map((cell) => {
            const level = step(cell.count);
            return (
              <td
                class:list={["heatmap__cell", { "is-empty": level < 0, "is-dark": level >= 3 }]}
                style={level >= 0 ? `background: ${HEAT_RAMP[level]}` : undefined}
                tabindex={level >= 0 ? 0 : undefined}
                data-tip={level >= 0 ? `${row.label} × ${cell.label}: ${cell.count} ${cell.count === 1 ? "story" : "stories"}` : undefined}
              >
                {cell.count || ""}
              </td>
            );
          })}
          <td class="heatmap__total">{row.total}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
