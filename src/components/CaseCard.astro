---
import { vendorLogoSvg } from "../lib/vendors";
import type { CardRecord } from "../lib/weeks";

type Props = {
  card: CardRecord;
};

// Every slot is always rendered (empty ones are `hidden`) so this component can
// also serve as the <template> the explorer clones for lazily loaded weeks.
const { card } = Astro.props;
const dots = [0, 1, 2, 3, 4, 5];
const logoMarkup = vendorLogoSvg(card.vendor, card.vendorMark);
---

<a
  class="case-card"
  href={card.url}
  data-case-card
  data-vendor={card.vendor}
  data-industry={card.industry}
  data-areas={card.areas.join("|")}
  data-usecases={card.useCases.join("|")}
  data-week={card.week}
  data-search={card.search}
>
  <span class="case-card__top">
    <span class="vendor-tag">
      <span class="vendor-tag__mark" data-slot="mark" style={`--vendor: ${card.vendorColor}`} set:html={logoMarkup} />
      <span data-slot="vendor">{card.vendor}</span>
    </span>
    <span class="tag tag--sample" data-slot="sample" hidden={!card.sample}>Sample</span>
    <span class="case-card__date" data-slot="published">{card.published}</span>
  </span>
  <span class="case-card__title" data-slot="customer">{card.customer}</span>
  <span class="case-card__meta">
    <span class="case-card__meta-item">
      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M2.5 13.5V6.8l3.6 2V6.8l3.6 2V4.5h3.8v9H2.5Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
      <span data-slot="industry">{card.industry}</span>
    </span>
    <span class="case-card__meta-sep" aria-hidden="true">·</span>
    <span class="case-card__meta-item">
      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M2.6 8h10.8M8 2.5c1.6 1.5 2.4 3.4 2.4 5.5S9.6 12 8 13.5c-1.6-1.5-2.4-3.4-2.4-5.5S6.4 4 8 2.5Z" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
      <span data-slot="region">{card.region}</span>
    </span>
  </span>
  <span class="case-card__problem" data-slot="problem">{card.problem}</span>
  <span class="case-card__metric" data-slot="metric" hidden={!card.metric}>{card.metric}</span>
  <span class="case-card__tags" data-slot="usecases">
    {card.useCases.slice(0, 2).map((useCase) => <span class="tag">{useCase}</span>)}
  </span>
  <span class="case-card__foot">
    <span class="case-card__products-wrap">
      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M8 2.5 13.5 5.3 8 8.1 2.5 5.3 8 2.5Zm5.5 5.5L8 10.8 2.5 8m11 2.7L8 13.5l-5.5-2.8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span class="case-card__products" data-slot="products">{card.products.join(" · ")}</span>
    </span>
    <span class="maturity" data-slot="maturity" title={`Maturity ${card.maturity}/6`} aria-label={`Maturity ${card.maturity} of 6`}>
      {dots.map((index) => <span class:list={["maturity__dot", { "is-on": index < card.maturity }]}></span>)}
    </span>
  </span>
</a>
