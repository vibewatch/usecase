{
  "name": "customer-use-case-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist",
    "preview": "astro preview",
    "data:seed": "python3 -m pipeline.usecase_intel.seed",
    "data:export": "python3 -m pipeline.usecase_intel.export",
    "data:discover": "python3 -m pipeline.usecase_intel.discover",
    "data:fetch": "python3 -m pipeline.usecase_intel.fetch",
    "data:triage": "python3 -m pipeline.usecase_intel.triage --stage pre && python3 -m pipeline.usecase_intel.triage --stage post && python3 -m pipeline.usecase_intel.triage --stage metadata && python3 -m pipeline.usecase_intel.triage --stage dates && python3 -m pipeline.usecase_intel.triage --stage summary",
    "data:probe-fetch": "python3 -m pipeline.usecase_intel.probe",
    "data:extract": "python3 -m pipeline.usecase_intel.extract",
    "data:enrich-companies": "python3 -m pipeline.usecase_intel.company_enrichment queue",
    "data:enrich-dates": "python3 -m pipeline.usecase_intel.date_enrichment queue",
    "data:validate-enrichment": "python3 -m pipeline.usecase_intel.company_enrichment validate",
    "data:merge": "python3 -m pipeline.usecase_intel.merge_records --prune-duplicates",
    "data:partition": "python3 -m pipeline.usecase_intel.partition",
    "data:analytics": "python3 -m pipeline.usecase_intel.analytics",
    "data:build": "npm run data:merge && npm run data:seed && npm run data:export && npm run data:partition && npm run data:analytics"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.2",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "astro": "^6.3.3",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "volar-service-yaml": "0.0.71",
    "yaml-language-server": "1.23.0",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
